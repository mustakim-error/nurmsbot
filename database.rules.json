{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
    },
    "gateways": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
    },
    "status": {
      ".read": true,
      ".write": true
    },
    "settings": {
      "bot_config": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
      },
      "admin_auth": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
      }
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "deposits": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      ".write": true
    },
    "transactions": {
      ".read": true,
      ".write": true
    },
    "referrals": {
      ".read": true,
      ".write": true
    },
    "processed_txs": {
      ".read": true,
      ".write": true
    },
    "broadcasts": {
      ".read": true,
      ".write": true
    }
  }
}
