# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Required Channel for Force-Subscription
# (Can also be dynamically updated from Firebase admin panel)
CHANNEL_ID=@YourOfficialChannel
CHANNEL_LINK=https://t.me/YourOfficialChannel
SHOP_NAME=Warzone Shop
SUPPORT_USERNAME=@YourSupportHandle

# Port for Render Health Check (Render automatically provides PORT)
PORT=3000

# Firebase Service Account (Use JSON string in production or path in local)
# Local:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Render / Cloud Environment: paste the entire JSON content in FIREBASE_SERVICE_ACCOUNT_JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
